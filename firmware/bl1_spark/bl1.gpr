project BL1 is

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src", "tests", "glue", "third_party/monocypher");
   for Object_Dir use "obj";
   for Exec_Dir use "../../build";
   for Main use ("bl1_check.adb", "sha256_check.adb", "ed25519_check.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-g", "-O1");
      for Default_Switches ("C") use
        ("-std=c99", "-O2", "-g", "-Wall", "-Wextra",
         "-I" & Project'Project_Dir & "third_party/monocypher");
   end Compiler;

end BL1;